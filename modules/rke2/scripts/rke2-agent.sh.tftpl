#!/bin/bash
# Bootstraps the RKE2 worker node and joins it to the control-plane. Run once over SSH by Terraform.
set -euo pipefail

exec > /var/log/rke2-install.log 2>&1

curl -sfL https://get.rke2.io | INSTALL_RKE2_TYPE="agent" INSTALL_RKE2_VERSION="${rke2_version}" sh -

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<CONFIG
server: "${server_url}"
token: "${token}"
CONFIG

systemctl enable rke2-agent.service
systemctl start rke2-agent.service
