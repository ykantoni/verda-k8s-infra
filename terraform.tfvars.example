# Copy to terraform.tfvars and adjust as needed.
# cp_ip/worker_ip are not variables here — they're read automatically from
# verda-vm-infra's state (see main.tf's terraform_remote_state data source).
# Its path defaults to ../verda-vm-infra/terraform.tfstate; override it with
# the TF_VAR_tfstate_location environment variable rather than setting it
# here, so it stays out of any committed tfvars file.
ssh_user              = "root"
ssh_private_key_path  = "~/.ssh/id_ed25519"
rke2_version          = "v1.37.1+rke2r1"
